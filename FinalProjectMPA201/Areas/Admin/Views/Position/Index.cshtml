@model List<PositionGetVM>
<div class="container">
	<div class="row">
        <a asp-area="Admin" asp-controller="Position" asp-action="Create"  class="btn btn-success">Create</a>
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col">Name</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                    {
                <tr>
                    
                        <th scope="row">@item.Id</th>
                        <td>@item.Name</td>
                        <td>
                            <a asp-area="Admin" asp-controller="Position" asp-action="Update" asp-route-id="@item.Id" class="btn btn-warning">Update</a>
                            <a asp-area="Admin" asp-controller="Position" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
                        </td>
                  
                </tr>
                }

            </tbody>
        </table>
	</div>
</div>