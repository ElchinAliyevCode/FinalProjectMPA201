@model EmployeeCreateVM
<div class="container">
	<div class="row">
		<div asp-validation-summary="ModelOnly" class="text-danger"></div>
		<form method="post" asp-area="Admin" asp-controller="Employee" asp-action="Create" enctype="multipart/form-data">
			<div class="form-group">
				<label asp-for="Name">Name</label>
				<input asp-for="Name" placeholder="Enter name">
				<span asp-validation-for="Name" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="Image">Image</label>
				<input asp-for="Image" placeholder="Enter Image">
				<span asp-validation-for="Image" class="text-danger"></span>
			</div>
			<div class="form-group">
				<select asp-for="PositionId">
					@foreach (var item in ViewBag.Positions)
					{
						<option value="@item.Id">@item.Name</option>
					}
				</select>
			</div>
			<button type="submit" class="btn btn-primary">Submit</button>
		</form>
	</div>
</div>